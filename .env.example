# Required: Gemini API Key - Get yours from https://aistudio.google.com/apikey
# The app will NOT build without this key.
VITE_GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional: EmailJS - Get your keys from https://dashboard.emailjs.com
# Service ID, Template ID, and Public Key for sending emails via EmailJS.
# If left unset, the contact form will be disabled and show a fallback
# message directing users to email support@bskcoding.com directly.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
